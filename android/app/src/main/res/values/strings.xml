	<!--
 Shared by both flavours. Anything that names a storage mechanism belongs
     to a flavour's own values/ instead (D62). 
	-->
<resources>
	<string name="app_name">wuDict2</string>
	<string name="starting">Starting wuDict2…</string>
	<string name="server_failed">wuDict2 server failed to start: %1$s</string>
	<!--
 The selection-toolbar entry (D67). It labels the PROCESS_TEXT filter
         only, where the toolbar is a row of verbs among other apps' verbs
         ("Read aloud", "Translate") and a product name would read as the odd
         one out. The share sheet keeps app_name. 
	-->
	<string name="lookup_label">wuDict2</string>
	<string name="lookup_starting">Looking up “%1$s”…</string>
	<string name="lookup_empty">Nothing to look up</string>
	<string name="lookup_open_app">Open in wuDict2</string>
	<!--
 The foreground service that keeps a demanded ingest alive
          (IndexService). The channel name is what appears in the system's
          notification settings, so it names the work rather than the app. 
	-->
	<string name="index_channel">Preparing dictionaries</string>
	<string name="index_title">Preparing a dictionary</string>
	<string name="index_text">Building the search index. This can take a few minutes.</string>
	<!--
 The same notification, worn by the other two long jobs that hold it.
          It is a receipt for work the user is waiting on, so it must say which
          work: a download that announces itself as indexing is telling the
          user the wrong thing about how long it will take and what it is
          spending - and for a multi-gigabyte .mdd over mobile data that is not
          a detail (D140). 
	-->
	<string name="index_import_title">Adding dictionaries</string>
	<string name="index_import_text">Copying into your library. This can take a few minutes.</string>
	<string name="index_download_title">Downloading a dictionary</string>
	<string name="index_download_text">This continues while you use other apps.</string>
	<!--
 The shell's own settings (D100). SINCE 2026-09-28 the rows themselves are
          drawn by the app page - the Settings drawer's System window
          (web/index.html, #sysSettings) - so the words a reader READS for the
          lookups, the messages, the access key, the browser cache and the
          Advanced headings live there now, in the page's own copy, the way the
          Appearance sheet's Screen rows got them. What is left here is the
          window's own chrome (its title and its two buttons) and the restart
          footer's sentences; the OVERRIDE rows' words below stay because the
          TABLE is Java's (ShellPrefs.OVERRIDES, whose flavour rows differ) and
          Shell.systemState sends each row's label and hint to the page with it.
	-->
	<string name="settings_short_label">Settings</string>
	<string name="settings_title">wuDict2 settings</string>
	<!--
 The signpost, and the reason the screen is not simply empty: it is on the
          launcher's long-press menu, so a reader who remembers the full screen
          arrives here.
	-->
	<string name="settings_moved_hint">These settings are in the app now — tap ☰ there and open System Settings. What is left here is what only this screen can do: set the server port, clear every advanced setting at once, and restart the dictionary server on the spot.</string>
	<!--
 Screen (D141): how the margins around the page are painted, and which
          bars hide while reading. Those two rows are NOT here any more - they
          live in the web Appearance sheet, where the wording belongs to the
          page that draws them (SCREEN_EDGE_OPTIONS and friends in
          web/index.html), and write the same ShellPrefs through the
          wudict:appearance bridge.
	-->
    <string name="settings_dictionary_picker">Dictionary picker</string>
    <string-array name="settings_dictionary_picker_modes">
        <item>All Dictionaries</item>
        <item>Found Dictionaries</item>
    </string-array>
    <string name="settings_dictionary_picker_hint">All Dictionaries changes where you search. Found Dictionaries jumps to a dictionary in the current results.</string>
    <string name="found_dictionaries_title">Found Dictionaries</string>
    <string name="found_dictionaries_empty">No dictionary articles are displayed yet.</string>
	<!--
 PLATFORM OVERRIDES (D101). Each row names a resource trade the DEVICE
          forces - space, memory, cores, an address - never a dictionary fact,
          which is the test for whether a row may exist here at all. The copy
          says what the value costs, because a number with no consequence
          attached is a number nobody can set responsibly. The rows are drawn
          by the app page, and these two strings per row are what it draws:
          Shell.systemState sends them with the row's bounds and its value, so
          a flavour that has no row (Play's listen address) sends none and the
          page cannot offer a control this build would not honour.
	-->
	<!--
 D102: the key is a setting like any other now, drawn in the page beside
          the rest; what has NOT changed is why it exists - other apps on the
          device can reach the dictionary server, and turning the key off is how
          you let one. Nothing about how the key works reaches the screen.
	-->
	<string name="settings_no_compress">Store dictionaries uncompressed</string>
	<string name="settings_no_compress_hint">Databases become roughly 3× larger — a 100 MB dictionary lands at about 300 MB. Reading gets slightly faster with no decompression step: expect a few percent, not a transformation. Applies to dictionaries prepared from now on. Default: off.</string>
	<string name="settings_search_memory">Memory one search may use</string>
	<string name="settings_search_memory_hint">A search that has to open dictionaries which are not prepared yet stops at this much; the rest are reported as not searched rather than opened. Prepared dictionaries are never capped. 0 removes the cap — one search across a large unprepared library has been measured at 6.3 GB, which on a phone means the app is killed.</string>
	<string name="settings_preview_memory">Memory unprepared dictionaries may hold</string>
	<string name="settings_preview_memory_hint">What stays open between searches: roughly 350 bytes per headword, so 64 MB holds about 180 000 of them. Past the cap the least recently used are closed and reopened on demand. Higher means fewer reopens and more memory the system will judge this app on.</string>
	<string name="settings_index_workers">Dictionaries prepared at once</string>
	<string name="settings_index_workers_hint">Each one saturates a core and holds a few hundred bytes per headword while it runs. More is faster and hotter; the phone stays comfortable at 1.</string>
	<string name="settings_server_port">Server port</string>
	<string name="settings_server_port_hint">Change only if something else on this device already uses 6889. Page preferences such as theme and panel state are saved per address, so a different port starts them fresh. Default: 6889.</string>
	<!--
 The three generic bits the PORT row on the shell screen needs, and the
          only row there that has any: the range it accepts, what the running
          server was started with, and what to say when a typed value is not a
          port. The page's System window says the same three things in its own
          words beside its own copy of the row - it draws that one, so it says
          it - and the two cannot drift in EFFECT: both write through
          ShellPrefs.setOverrideChecked, which is the validator these words
          describe.
	-->
	<string name="settings_range">Between %1$d and %2$d.</string>
	<string name="settings_in_effect">In effect now: %1$s.</string>
	<string name="settings_out_of_range">“%1$s” must be a whole number between %2$d and %3$d.</string>
	<!--
 The running server was started with different values. Never claims a
          restart that did not happen: the button appears only when stopping it
          is actually safe - and this screen is the ONLY place it can appear,
          because a page that shows the System window holds the server itself
          and so can never offer to stop it.
	-->
	<string name="settings_stale">The dictionary server is still running with the previous settings.</string>
	<string name="settings_stale_later">It will pick them up the next time the app is opened.</string>
	<string name="settings_apply_now">Restart server now</string>
	<string name="settings_applied">Stopped. The new settings apply on the next lookup.</string>
	<string name="settings_close">Close</string>
	<string name="settings_restore">Restore defaults</string>
	<string name="settings_restore_confirm">Clear every advanced setting and go back to what the settings file says?</string>
	<string name="settings_restore_done">Advanced settings cleared.</string>
	<string name="settings_cancel">Cancel</string>
	<!--
 Intake: an archive arriving from a file manager, a share sheet or the
          page's own picker. Present in both flavours, unlike the import_*
          strings, which belong to the Play flavour's folder importer. Progress
          is one line and names no staging folder, no job and no archive
          internals (D102). 
	-->
	<string name="intake_title">Add dictionaries</string>
	<string name="intake_reading">Reading %1$s…</string>
	<!--
 The dialog's title. It names the SOURCE, not the outcome: nothing has
          been added at the moment it appears - the list below is the question
          and the Add button is the answer - and one archive can hold five
          dictionaries, so a title naming one of them would be naming the wrong
          thing (D137). 
	-->
	<string name="intake_add_from">Add from %1$s</string>
	<!--
 A dictionary in that list. Name first, because it is the identity and
          what the library will call it; then the files it is made of, because
          a bare title does not say WHICH file is about to be downloaded or
          replaced and on a phone that is the whole of the decision; then the
          total, when there is a download to weigh. Same grammar as the extra
          rows below - "·" separates facts, "—" introduces a state (D137). 
	-->
	<string name="intake_cand">%1$s · %2$s · %3$s</string>
	<!--
 The same row without the total: a dictionary that is already
          installed, or that cannot be installed, costs no bytes to decide
          about, and the state it carries instead is what the row is for. 
	-->
	<string name="intake_cand_short">%1$s · %2$s</string>
	<!--
 A StarDict set is a handful of files and a resource folder; the list
          is cut rather than allowed to become the row. 
	-->
	<string name="intake_files_more">+%1$d more</string>
	<!--
 %2$s lists what the set is missing, so an entry that cannot be ticked
          says why instead of simply refusing. 
	-->
	<string name="intake_needs">%1$s — needs %2$s</string>
	<!--
 The same missing files, but found beside the download and offered
          below: the choice is about the state AFTER the companions arrive, so
          the entry can be ticked and says why. 
	-->
	<string name="intake_needs_found">%1$s — needs %2$s, found below</string>
	<!--
 A dictionary the library already holds. Adding it again REPLACES it
          rather than leaving two, so the entry says which of the two it is:
          one worth ticking, one already done and left unticked (D134). 
	-->
	<string name="intake_update">%1$s — replaces your copy</string>
	<string name="intake_same">%1$s — already installed</string>
	<!--
 A folder of that name is there and holds no dictionary: one a removal
          left behind, or one the user made. The install takes it over either
          way, so it is said - but it is not an installation, and calling it
          one tells somebody a dictionary they have just removed is still
          there (D137). 
	-->
	<string name="intake_stale">%1$s — takes over a folder of this name</string>
	<string name="intake_install">Add</string>
	<string name="intake_cancel">Cancel</string>
	<!--
 A link, fetched by the server. %1$s is the site, not the URL: a
          shared link may carry a session token, and the host is what tells the
          user where this is coming from. No percentage when the site declared
          no length - a number that stops moving is worse than none. 
	-->
	<string name="intake_connecting">Connecting…</string>
	<string name="intake_downloading">Downloading from %1$s…</string>
	<string name="intake_downloading_pct">Downloading from %1$s… %2$d%%</string>
	<!--
 Once the site has answered, the FILE is named: an import fetches a
          dictionary and then, one at a time, the companion files the user
          ticked, and a line that said only the host could not tell those
          apart. %1$s is the file, %2$s the site. 
	-->
	<string name="intake_downloading_named">Downloading %1$s from %2$s…</string>
	<string name="intake_downloading_named_pct">Downloading %1$s from %2$s… %3$d%%</string>
	<!--
 Companion files found beside the downloaded one and OFFERED, never
          taken: an .mdx is a few megabytes and its .mdd can be several
          gigabytes of somebody else's mobile data. Ticked by default because
          a dictionary without its media has no images or sound; ticked and not
          downloaded, because the size is the decision and it is the user's.
          %1$s is the file, %2$s its size, %3$s why it belongs. 
	-->
	<string name="intake_extra">%1$s · %2$s — %3$s</string>
	<string name="intake_extra_nosize">%1$s — %2$s</string>
	<string name="intake_extra_needed">needed</string>
	<string name="intake_extra_media">images and sounds</string>
	<string name="intake_extra_other">optional</string>
	<string name="intake_installing">Adding… %1$d%%</string>
	<string name="intake_done">Added %1$s.</string>
	<string name="intake_done_partial">Added %1$s.\n\nThe rest did not arrive: %2$s</string>
	<string name="intake_none">Nothing was added.</string>
	<string name="intake_nothing">%1$s holds no dictionaries wuDict2 can read.</string>
	<!--
 A file TAPPED in a file manager that turns out not to be one this
          app reads. It exists because the open-with filter can only match on
          MIME and every dictionary format arrives as application/octet-stream,
          so wuDict2 is offered for untyped files in general - and an app that
          was chosen and then did nothing visible reads as broken. Names the
          app, because in a sheet full of other apps' verbs "not supported" on
          its own does not say WHO could not read it (D138). 
	-->
	<string name="intake_unsupported">wuDict2 cannot read %1$s.</string>
	<string name="intake_cancelled">Cancelled.</string>
	<string name="intake_busy">An import is already running.</string>
	<string name="intake_failed">Could not add dictionaries: %1$s</string>
	<string name="intake_no_server">The dictionary server did not start, so nothing could be added.</string>
	<string name="intake_no_picker">This device has no file picker.</string>
</resources>
