<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- System dark mode (API 29+): the dark parent so nothing the framework
         draws — dialogs, the storage-permission prompt — comes up white
         against a page that is dark. -->
    <!-- Runtime theme. MainActivity starts with Theme.WuWeiDict.Startup
         from the manifest, then restores this theme before creating views.
         Java paints the saved page/Sepia background before the first frame. -->
    <style name="Theme.WuWeiDict" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowIsTranslucent">false</item>
        <item name="android:windowBackground">@color/window_bg</item>
        <item name="android:colorBackground">@color/window_bg</item>
        <item name="android:windowSplashScreenBackground" tools:targetApi="31">@color/window_bg</item>
    </style>

    <!-- The dark parent for the lookup popup (D67), for the same reason. -->
    <style name="Theme.WuWeiDict.Lookup" parent="android:Theme.Material.Dialog.NoActionBar">
        <item name="android:windowBackground">@color/window_bg</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowCloseOnTouchOutside">true</item>
    </style>
</resources>
