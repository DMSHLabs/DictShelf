<!-- The previous app stored localStorage under an HTTP loopback origin. Android
     temporarily opens that origin through WebView interception on first-run
     import; no listener or network server is started. Cleartext stays limited
     to loopback so an old profile can be read without allowing arbitrary HTTP. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
