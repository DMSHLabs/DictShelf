<!-- The GitHub / F-Droid flavour (D62). Everything Play objects to lives
     here and nowhere else, so the `play` build cannot inherit it: the merger
     is additive, and no flavour ever removes another's node.

     D5 (user-approved): dictionaries are read from the shared "Dictionaries"
     folder. All-files access covers API 30+; the legacy pair covers 26–29
     (WRITE is granted at runtime on those). requestLegacyExternalStorage is
     the 29-and-below half of the same story, so it belongs here too. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="29" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />

    <application android:requestLegacyExternalStorage="true">

        <!-- Sharing a LOOSE dictionary file to this app (D138). The archive
             types are claimed in src/main and handled by the flavour-neutral
             Intake; these are per-flavour because their HANDLER is: the Play
             flavour copies shared documents through SafImporter, which is its
             only way past the Storage Access Framework, while this flavour
             holds all-files access and can have the server read the file
             where it lies - which is also how the .mdd beside a shared .mdx
             comes along, since the server finds siblings by looking in the
             folder rather than by being handed them.

             Until now this flavour had no share target at all: the octet-
             stream filters lived only in src/play, and foss Storage.onNewIntent
             was an empty stub. So a .mdx could be opened here but not shared
             here, which is the gap this closes.

             application/gzip belongs here, unlike in the VIEW filter: a share
             is a file the user has already named this app for, so a .dsl.dz
             costs nothing to accept and a .tar.gz costs one sentence. -->
        <activity android:name=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/octet-stream" />
                <data android:mimeType="application/gzip" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/octet-stream" />
                <data android:mimeType="application/gzip" />
            </intent-filter>
        </activity>
    </application>
</manifest>
