// The _windows_amd64 suffix makes cmd/go link the object ONLY for that
// GOOS/GOARCH pair; an unsuffixed .syso is linked into every target, where
// the Android ELF linker rejects it ("unknown file type").
// Regenerate with windres -F pe-x86-64 -i packaging/windows/dictshelf.rc -o dictshelf_windows_amd64.syso.
// 101 is the active application icon; keep the other artwork available as
// executable resources for platform-specific consumers.
101 ICON "packaging/windows/dictshelf.ico"
102 ICON "packaging/brand/source/DictShelf.ico"
103 ICON "packaging/brand/source/DictShelf_transparent.ico"
104 ICON "packaging/brand/source/DictShelf2_transparent.ico"
